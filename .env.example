# Bu dosyayı .env olarak kopyala ve değerleri doldur: cp .env.example .env
# .env dosyası .gitignore'dadır, repoya eklenmez.
# Hem docker compose hem Spring Boot (spring.config.import) bu dosyayı okur.

DB_PASSWORD=change-me

# Demo kullanıcılarının ortak parolası; yalnızca seed profili okur (./mvnw spring-boot:run -Dspring-boot.run.profiles=seed)
SEED_DEMO_PASSWORD=change-me-too
