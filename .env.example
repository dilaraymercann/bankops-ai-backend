# Bu dosyayı .env olarak kopyala ve değerleri doldur: cp .env.example .env
# .env dosyası .gitignore'dadır, repoya eklenmez.
# Hem docker compose hem Spring Boot (spring.config.import) bu dosyayı okur.

DB_PASSWORD=change-me

# Demo kullanıcılarının ortak parolası; yalnızca seed profili okur (./mvnw spring-boot:run -Dspring-boot.run.profiles=seed)
SEED_DEMO_PASSWORD=change-me-too

# JWT imzalama anahtarı (en az 32 karakter). Üretmek için: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-0000

# Google Gemini API anahtarı (AI analizi ve embedding). https://aistudio.google.com adresinden ücretsiz alınır.
# Boş bırakılırsa AI özellikleri kapalı olur, uygulama yine çalışır. ASLA repoya eklenmez.
GEMINI_API_KEY=
